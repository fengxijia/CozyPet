# Copy to .env and fill in. Never commit the real .env.

# What the macOS app sends in X-Client-Token. Pick a random string; rotate if you
# suspect a leak. Long enough to defeat guessing (>= 24 chars). Don't share publicly.
CLIENT_TOKEN=replace-me-with-a-long-random-string

# Real upstream keys — only ever live here, never in the app.
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...

# Tunables.
PORT=8080
ANTHROPIC_REQ_PER_MIN=30
ELEVENLABS_REQ_PER_MIN=20
ELEVENLABS_CHARS_PER_DAY=50000
